# Copia este archivo a .env solo si necesitas cambiar algo. Con los valores por
# defecto (SQLite + puerto 8000) NO hace falta ningún .env — la app funciona sola.

# Base de datos: por defecto un archivo SQLite en data/sanitapoint.db.
# Descomenta y ajusta solo si quieres moverla o usar otro motor.
# DATABASE_URL=sqlite:////ruta/absoluta/a/sanitapoint.db

# Interfaz y puerto donde escucha el servidor.
# 0.0.0.0 = accesible desde todas las cajas de la red local.
SANITAPOINT_HOST=0.0.0.0
SANITAPOINT_PORT=8000

# KAME: entorno > .env > configuración web. No guardes secretos en este archivo.
# KAME_MODO=mock
