# Copia este archivo a .env solo si necesitas cambiar algo. Con los valores por
# defecto (SQLite + puerto 8000) NO hace falta ningún .env — la app funciona sola.

# Base de datos: por defecto un archivo SQLite en data/sanitapoint.db.
# Descomenta y ajusta solo si quieres moverla o usar otro motor.
# DATABASE_URL=sqlite:////ruta/absoluta/a/sanitapoint.db

# Interfaz y puerto donde escucha el servidor.
# 0.0.0.0 = accesible desde todas las cajas de la red local.
SANITAPOINT_HOST=0.0.0.0
SANITAPOINT_PORT=8000

# KAME se configura exclusivamente aquí (o mediante variables de entorno).
KAME_MODO=real
# Usa KAME_MODO=mock solamente para pruebas sin emitir boletas.
# KAME_BASE_URL=https://api.kameone.cl
# KAME_CLIENT_ID=
# KAME_CLIENT_SECRET=
# KAME_USER=
# KAME_TOKEN=
# KAME_SUCURSAL=
# KAME_UNIDAD_MEDIDA=UN
# KAME_UNIDAD_NEGOCIO=CASA MATRIZ
# Unidad de negocio segun el servicio; si faltan, se usa KAME_UNIDAD_NEGOCIO.
# KAME_UNIDAD_NEGOCIO_BANO=
# KAME_UNIDAD_NEGOCIO_DUCHA=
# KAME_DETALLE_EXENTO=
# RUT de la empresa emisora (no del cliente), necesario para recuperar PDF/XML.
# KAME_RUT=
# KAME_RAZON_SOCIAL=

# Datos de la resolucion del emisor para el ticket termico, cuando el XML
# individual entregado por KAME no incluye Caratula/NroResol y FchResol.
# Copiar los valores reales del emisor; no usar datos de ejemplos.
# KAME_RESOLUCION_NUMERO=
# KAME_RESOLUCION_FECHA=AAAA-MM-DD
